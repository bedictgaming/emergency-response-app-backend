{
  "name": "emergency-response-app-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/copy-prisma-client.mjs && tsc-alias --resolve-full-paths",
    "start": "node ./dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "cross-env RUN_DATABASE_TESTS=1 vitest run tests/database.integration.test.ts",
    "test:delivery": "node scripts/run-disposable-delivery-tests.mjs",
    "check": "npm run build && npm run check:runtime && npm test",
    "check:runtime": "node scripts/check-built-runtime.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "evidence:migrate-private": "tsx src/migrate-evidence-private.ts",
    "db:backup": "tsx src/backup-database.ts",
    "db:encrypt-legacy-backups": "tsx src/encrypt-legacy-backups.ts",
    "db:restore": "tsx src/restore-database.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "6.12.0",
    "@prisma/client": "6.12.0",
    "@types/multer": "^2.2.0",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.21.0",
    "pino-http": "^11.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.2",
    "@types/nodemailer": "^8.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "cross-env": "^10.1.0",
    "prisma": "6.12.0",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
