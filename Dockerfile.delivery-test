FROM node:24-bookworm-slim
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY prisma ./prisma
COPY prisma.config.ts tsconfig.json vitest.config.ts ./
COPY src ./src
COPY tests ./tests
COPY scripts/run-disposable-delivery-tests.mjs ./scripts/
RUN npx prisma generate
ENV NODE_ENV=test
CMD ["npm", "run", "test:delivery"]
