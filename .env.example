APP_NAME=Emergency Response App
PORT=8000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/emergency_response
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/emergency_response
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Optional. Leave empty for a safer host-only cookie; set only when sharing a parent domain.
COOKIE_DOMAIN=
# Only set behind a known reverse proxy; comma-separated proxy IPs or CIDRs.
TRUSTED_PROXY_CIDRS=
JWT_SECRET=replace-with-at-least-32-random-characters
# Optional one-time main-admin bootstrap; never reuse these values after provisioning.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=emergency-incidents
CLOUDINARY_MAX_FILE_SIZE_MB=8
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com
