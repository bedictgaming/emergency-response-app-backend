APP_NAME=Emergency Response App
PORT=8000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/emergency_response
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/emergency_response
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Optional. Leave empty for a safer host-only cookie; set only when sharing a parent domain.
COOKIE_DOMAIN=
# Only set behind a known reverse proxy; comma-separated proxy IPs or CIDRs.
TRUSTED_PROXY_CIDRS=
# Authenticated first-party gateway. Default off; enable on isolated staging first.
# Dedicated server-only secret, never JWT_SECRET or NEXT_PUBLIC_*; unique per environment.
API_GATEWAY_REQUIRED=false
API_GATEWAY_SECRET=
API_GATEWAY_AUDIENCE=
# Disable workers on synthetic staging; production normally retains true.
BACKGROUND_JOBS_ENABLED=true
# Staging must use its own namespace and BACKGROUND_JOBS_ENABLED=false.
# Shared provider credentials are still a residual risk; prefer separate environments.
EVIDENCE_NAMESPACE=emergency-incidents
# Fail closed by default. Retain queued jobs until reviewed explicitly.
EVIDENCE_DELETION_ENABLED=false
ORPHAN_EVIDENCE_SWEEP_ENABLED=false
JWT_SECRET=replace-with-at-least-32-random-characters
# Optional one-time main-admin bootstrap; never reuse these values after provisioning.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=
# Selected account-email transport. Default smtp preserves existing hosts.
# Railway Free/Trial/Hobby requires an HTTPS transport, not SMTP.
# Available: smtp, resend, brevo, vercel-relay. Selection is explicit; no fallback.
MAIL_PROVIDER=smtp
# Option without a sending domain: separately configured private Vercel Gmail relay.
# Dedicated 32-byte hex secret, never JWT/gateway/SMTP credentials or NEXT_PUBLIC_*.
MAIL_RELAY_URL=
# Existing Vercel project: https://cordova-emergency-response.vercel.app/api/account-email
# Requires separately configured/accepted server-only relay; no client/browser call.
MAIL_RELAY_AUDIENCE=
MAIL_RELAY_SECRET=
# Resend: verified-domain sender mailbox (not onboarding@resend.dev in production).
MAIL_FROM=
RESEND_API_KEY=
# Brevo HTTPS mode: MAIL_PROVIDER=brevo, MAIL_FROM=your verified sender address.
# Requires transactional sending activated by Brevo. No SMTP key/relay/database needed.
# Server-only API key, never NEXT_PUBLIC_*, chat, Git or browser storage.
BREVO_API_KEY=
# Free plan: 300 sends/day shared across verification and password-reset messages.
# Free-mail senders may be rewritten by Brevo; use an authenticated domain long-term.
# SMTP mode only. MAIL_FROM may replace SMTP_FROM; leave MAIL_FROM unset for legacy SMTP_FROM.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=emergency-incidents
CLOUDINARY_MAX_FILE_SIZE_MB=8
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com
